{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://appfacts.dev/schema/app-facts.schema.json",
  "title": "AppFacts frontmatter",
  "type": "object",
  "required": [
    "app_facts_version",
    "name",
    "type",
    "status",
    "license",
    "stack",
    "key_dependencies",
    "build",
    "generated"
  ],
  "properties": {
    "app_facts_version": {
      "type": "string",
      "description": "Spec version this file conforms to, e.g. 0.1.0"
    },
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form project kind. Recommended values: web app (SPA), web app (SSR), CLI tool, API service, mobile app, library, spec / tooling, monorepo, desktop app, other."
    },
    "status": {
      "type": "string",
      "enum": ["active", "maintenance", "archived", "experimental"]
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier when known, otherwise UNKNOWN"
    },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "stack": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1,
      "description": "Free-form layer → choice map. Common keys: language, runtime, framework, styling, state, backend, database, hosting, ai, billing, analytics, email, scraping, auth."
    },
    "key_dependencies": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "maxItems": 6,
      "description": "Optional curated third-party / hosted integrations (separate from package key_dependencies).",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "generated": {
      "type": "object",
      "required": ["date", "generator"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "generator": { "type": "string", "minLength": 1 },
        "inputs_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$",
          "description": "First 16 hex chars of SHA-256 over the generator's scanned inputs. Used by --check to detect staleness."
        }
      },
      "additionalProperties": false
    },
    "credits": {
      "type": "object",
      "properties": {
        "generated_with": { "type": "string" },
        "built_by": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
